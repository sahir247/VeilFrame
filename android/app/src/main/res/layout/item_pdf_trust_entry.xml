<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pdf_code_box"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivTrustIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="Trust Anchor"
        android:src="@drawable/ic_certificate"
        app:tint="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTrustTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Root CA Name"
            android:textColor="@color/vf_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrustFingerprint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:text="SHA-256: 00:11:22:..."
            android:textColor="@color/vf_text_muted"
            android:textSize="10sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeletePin"
        style="@style/Widget.VeilFrame.IconButton.Toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Remove Pin"
        android:visibility="gone"
        app:icon="@drawable/ic_close"
        app:iconTint="@color/vf_accent_red" />
</LinearLayout>
