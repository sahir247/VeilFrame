<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vf_surface"
    android:orientation="vertical">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/vf_surface_variant">

        <TextView
            android:id="@+id/tvExifDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit EXIF Metadata"
            android:textColor="@color/vf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
        android:ellipsize="end"
        android:singleLine="true"
        android:maxLines="1"
            android:id="@+id/btnExifClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close EXIF Dialog"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/vf_text_secondary" />
    </LinearLayout>

    <!-- Scrollable Form Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="440dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="View, edit, or wipe sensitive camera metadata &amp; identifiers."
                android:textColor="@color/vf_text_secondary"
                android:textSize="12sp" />

            <!-- Section 1: Device & Camera Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="DEVICE &amp; HARDWARE"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Camera Maker">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExifMake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:hint="Camera Model">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExifModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Software / Firmware">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExifSoftware"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Section 2: Timestamp -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="TIMESTAMP"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Capture Date &amp; Time">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExifDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Section 3: Geolocation Privacy -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="GEOLOCATION (GPS)"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="GPS Coordinates">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etExifGps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Danger Strip Action -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExifStripAll"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Wipe All Metadata"
                android:textColor="@color/vf_accent_amber"
                app:backgroundTint="@color/vf_status_warn_bg"
                app:icon="@drawable/ic_exif"
                app:iconTint="@color/vf_accent_amber" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/vf_surface_variant">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExifRestore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Restore Original"
            android:textColor="@color/vf_text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExifDone"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Done"
            android:textColor="@color/vf_on_primary"
            app:backgroundTint="@color/vf_primary" />
    </LinearLayout>
</LinearLayout>
