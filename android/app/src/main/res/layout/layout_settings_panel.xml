<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:elevation="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingsClose"
            style="@style/Widget.VeilFrame.IconButton.Toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Close Settings"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/vf_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSettingsHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings &amp; Appearance"
                android:textColor="@color/vf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />
        </LinearLayout>
    </LinearLayout>


    <!-- Content ScrollView -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Section 1: Base Theme Mode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Theme mode"
                android:textColor="@color/vf_accent_green"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgThemeMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbThemeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="Follow System\nMatches device day / night setting"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbThemeLight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="Light\nCrisp daylight palette"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbThemeDark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="Dark\nCharcoal matte dark theme"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbThemeAmoled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="6dp"
                    android:text="AMOLED Dark\nPure #000000 true black for OLED battery savings"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Section 2: Material You Dynamic Colors -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Material You Dynamic Color"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Derive accent colors from system wallpaper (Android 12+). Takes precedence over custom palettes."
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDynamicColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- Section 3: Custom Accent Palettes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Accent palette (when Dynamic Color is off)"
                android:textColor="@color/vf_accent_green"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDynamicColorNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Custom accent palettes are disabled while Dynamic Color is enabled."
                android:textColor="@color/vf_status_info"
                android:textSize="11sp"
                android:visibility="gone" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAccentPalette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPaletteMonochrome"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monochrome" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPaletteForestSage"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forest Sage" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPaletteDeepOcean"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Deep Ocean" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPaletteWarmAmber"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warm Amber" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPaletteCyberViolet"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cyber Violet" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Section 4: Typography -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Typography style"
                android:textColor="@color/vf_accent_green"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTypography"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/rbTypoSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="System Font (Android OS Default)"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbTypoSans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="Modern Sans (Plus Jakarta Sans)"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbTypoMonospace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="Terminal Monospace"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbTypoSerif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="Editorial Serif"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />
            </RadioGroup>

            <!-- Section 5: Storage Governor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Storage governor"
                android:textColor="@color/vf_accent_green"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Auto-prunes oldest exports and temporary cache when storage exceeds limit. Neural AI and CV models are strictly preserved."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <RadioGroup
                android:id="@+id/rgStorageLimit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbStorage1Gb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="1 GB"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbStorage2Gb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="2 GB (Default)"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbStorage4Gb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="4 GB"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbStorage8Gb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="8 GB"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbStorageUnlimited"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="4dp"
                    android:text="Unlimited"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />
            </RadioGroup>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
