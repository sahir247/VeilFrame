<?xml version="1.0" encoding="utf-8"?>
<!-- Page Studio Fine Editing Dialog: Complete Image Studio capabilities integrated into Document Scanner.
     Supports Fine Tuning, Warmth, Color Filters, and Text Watermarking/Stamping. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurfaceContainer"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Page Studio • Fine Edit"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:text="Non-destructive optical enhancements, color filtering, and document watermarking"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <!-- SECTION 1: COLOR FILTERS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter &amp; Palette"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAdjustFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterEnhanced"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enhanced" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterBw"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B&amp;W" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterGrayscale"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grayscale" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterReceipt"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receipt" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterIdDoc"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID Doc" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterSepia"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sepia" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterVintage"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vintage" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterCool"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cool" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterWarm"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warm" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustFilterOriginal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Original" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- SECTION 2: FINE ADJUSTMENTS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fine Tuning"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Exposure (stops)"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustExposure"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-2.0"
            android:valueTo="2.0"
            android:stepSize="0.1"
            android:value="0.0" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Contrast"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustContrast"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.5"
            android:valueTo="2.0"
            android:stepSize="0.05"
            android:value="1.0" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Saturation"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustSaturation"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="2.0"
            android:stepSize="0.05"
            android:value="1.0" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Warmth / Temperature"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustWarmth"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="-1.0"
            android:valueTo="1.0"
            android:stepSize="0.1"
            android:value="0.0" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Text Sharpness"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustSharpen"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="2.0"
            android:stepSize="0.1"
            android:value="0.0" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Denoise / Clean"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustDenoise"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="0.0"
            android:valueTo="10.0"
            android:stepSize="1.0"
            android:value="0.0" />

        <!-- SECTION 3: TEXT WATERMARK & STAMP -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Document Watermark &amp; Stamp"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Watermark Text (e.g. CONFIDENTIAL)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAdjustWatermarkText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick Stamp Presets -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustWmConfidential"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="CONFIDENTIAL" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustWmCopy"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="COPY" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustWmDraft"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="DRAFT" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustWmDoNotShare"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DO NOT SHARE" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Watermark Position -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Position"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupAdjustWmPosition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustPosBottomRight"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bottom Right" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustPosCenter"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Center" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustPosTopRight"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Right" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustPosTopLeft"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top Left" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdjustPosBottomLeft"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bottom Left" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Watermark Size & Opacity -->
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Watermark Size"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustWatermarkSize"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="12.0"
            android:valueTo="72.0"
            android:stepSize="2.0"
            android:value="28.0" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Watermark Opacity"
            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderAdjustWatermarkOpacity"
            style="@style/Widget.VeilFrame.Slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:valueFrom="10.0"
            android:valueTo="100.0"
            android:stepSize="5.0"
            android:value="60.0" />

        <!-- Dialog Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdjustReset"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="Reset All" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdjustCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdjustApply"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apply"
                app:icon="@drawable/ic_done" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
