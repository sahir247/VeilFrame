<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CameraX preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/qr_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scan viewfinder overlay (custom view drawn on top of camera) -->
    <com.veilframe.app.qr.ui.QrScanOverlayView
        android:id="@+id/qr_scan_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Bottom controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qr_scan_gallery_btn"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:elevation="4dp"
            app:elevation="4dp"
            app:cornerRadius="26dp"
            android:paddingHorizontal="24dp"
            app:icon="@drawable/ic_tab_image"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            android:text="Import from Gallery"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <!-- Scan result card (hidden until a QR is detected) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/qr_result_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/qr_result_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:text="Type" />

                <TextView
                    android:id="@+id/qr_result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/qr_result_action_btn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    app:cornerRadius="16dp"
                    android:text="Open" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
