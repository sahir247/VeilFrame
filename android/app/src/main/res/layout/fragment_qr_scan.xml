<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CameraX preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/qr_camera_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Scan viewfinder overlay (custom view drawn on top of camera) -->
    <com.veilframe.app.qr.ui.QrScanOverlayView
        android:id="@+id/qr_scan_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dynamic guidance text below targeting reticle -->
    <TextView
        android:id="@+id/qr_scan_guidance_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="116dp"
        android:background="@drawable/bg_pill_accent"
        android:backgroundTint="#99000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Point camera at a QR code"
        android:textColor="#FFFFFF"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <!-- Torch / Flashlight Toggle Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/qr_torch_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:fabSize="mini"
        android:contentDescription="Toggle flashlight"
        app:srcCompat="@drawable/ic_flash_off"
        app:tint="#FFFFFF"
        android:backgroundTint="#66000000"
        app:borderWidth="0dp"
        android:visibility="gone" />

    <!-- Permission-denied State Overlay -->
    <LinearLayout
        android:id="@+id/container_camera_permission_denied"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_tool_qr"
            app:tint="?attr/colorOnSurfaceVariant"
            android:contentDescription="Camera Disabled" />

        <TextView
            android:id="@+id/qr_camera_permission_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Camera access is disabled"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/qr_camera_permission_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="VeilFrame needs camera access to scan QR codes with your device."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qr_allow_camera_btn"
            style="@style/Widget.VeilFrame.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Allow Camera" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qr_open_settings_btn"
            style="@style/Widget.VeilFrame.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Open Settings"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qr_permission_import_gallery_btn"
            style="@style/Widget.VeilFrame.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import from Gallery" />
    </LinearLayout>

    <!-- Camera Error State Overlay -->
    <LinearLayout
        android:id="@+id/container_camera_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_info_outline"
            app:tint="?attr/colorError"
            android:contentDescription="Camera Error" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Unable to start camera"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/qr_camera_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Could not initialize CameraX hardware pipeline."
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qr_camera_retry_btn"
            style="@style/Widget.VeilFrame.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Try Again" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qr_error_import_gallery_btn"
            style="@style/Widget.VeilFrame.Button.Quiet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Import from Gallery" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/container_scan_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#AA000000"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/qr_scan_gallery_btn"
            style="@style/Widget.VeilFrame.Button.Elevated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:elevation="4dp"
            app:elevation="4dp"
            android:paddingHorizontal="24dp"
            app:icon="@drawable/ic_tab_image"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            android:text="Import from Gallery"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <!-- Scan result card (hidden until a QR is detected) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/qr_result_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorSurfaceVariant"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/qr_result_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:text="Type" />

                <TextView
                    android:id="@+id/qr_result_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="6"
                    android:ellipsize="end"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qr_result_toggle_pwd_btn"
                        style="@style/Widget.VeilFrame.Button.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_visibility"
                        app:iconPadding="4dp"
                        android:text="Show"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qr_scan_another_btn"
                        style="@style/Widget.VeilFrame.Button.Quiet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Scan Another" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/qr_result_action_btn"
                        style="@style/Widget.VeilFrame.Button.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</FrameLayout>
