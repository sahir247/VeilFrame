<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutBackgroundRemoverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarBgRemover"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="BG Remover"
            app:titleTextColor="?attr/colorOnSurface"
            app:subtitle="On-Device Neural Matting"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant">

            <!-- Model Manager Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBgModelManager"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:contentDescription="AI Model Manager"
                app:icon="@drawable/ic_system_update"
                app:iconTint="?attr/colorOnSurface" />

            <!-- Quick Save / Export Action in Toolbar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBgToolbarExport"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:contentDescription="Export cutout"
                app:icon="@drawable/ic_action_save"
                app:iconTint="?attr/colorOnSurface" />

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Preview Area Frame -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <!-- Empty State Hero (Scrollable on short displays) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/containerBgEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Value Proposition Badges -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pass"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginEnd="8dp"
                            android:text="On-Device AI"
                            android:textColor="@color/vf_accent_green"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_neutral"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginEnd="8dp"
                            android:text="Zero Cloud"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_neutral"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="100% Private"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_crop"
                        app:tint="@color/vf_primary"
                        android:contentDescription="Select Image" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Remove Backgrounds in One Tap"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Private, fast, and high-precision subject matting with SOTA neural models."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:maxWidth="300dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBgPickImage"
                        style="@style/Widget.VeilFrame.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Choose Photo"
                        app:icon="@drawable/ic_tab_image" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Interactive Before/After Split Comparison View -->
            <com.veilframe.app.ui.views.BeforeAfterSplitView
                android:id="@+id/splitViewBgCompare"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Interactive Picsart-Style Brush & Eraser Refinement Canvas -->
            <com.veilframe.app.ui.views.RefineBrushCanvasView
                android:id="@+id/refineBrushCanvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- Processing Overlay HUD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBgProcessingOverlay"
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="20dp"
                app:cardElevation="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/vf_surface_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        style="@style/Widget.VeilFrame.Progress.Wavy"
                        android:id="@+id/progressBgInference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:indeterminate="false"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tvBgProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="45%"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBgProgressMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Removing background…"
                        android:textColor="@color/vf_text_secondary"
                        android:textSize="12sp"
                        android:gravity="center" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- Controls Strip (Visible when image is loaded) -->
        <com.veilframe.app.ui.MaxHeightNestedScrollView
            android:id="@+id/containerBgControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="220dp"
            android:visibility="gone"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp">

                <!-- Active Model Selection Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBgActiveModel"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/vf_surface_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="MATTING ENGINE MODE"
                                android:textColor="@color/vf_text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBgChangeModel"
                                style="@style/Widget.VeilFrame.Button.Action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Storage"
                                app:icon="@drawable/ic_system_update"
                                app:iconSize="14dp" />
                        </LinearLayout>

                        <!-- Direct User-Facing Segmented Mode Selector -->
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/toggleGroupMattingMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="8dp"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeSelectHybrid"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Hybrid"
                                android:textSize="12sp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeSelectU2Net"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="U²-Net-P"
                                android:textSize="12sp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnModeSelectModNet"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="MODNet HD"
                                android:textSize="12sp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>

                        <!-- Dynamic Mode Description & Badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:id="@+id/tvBgCurrentModelName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hybrid (Smart Auto)"
                                android:textColor="@color/vf_text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvBgModelBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_badge_pass"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="Smart Auto"
                                android:textColor="@color/vf_accent_green"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBgModelDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Intelligently routes humans, animals &amp; objects for crisp edge preservation."
                            android:textColor="@color/vf_text_secondary"
                            android:textSize="11sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Processing Options Card (Tighten, Feather, Trim) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/vf_surface_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PROCESSING OPTIONS"
                            android:textColor="@color/vf_text_muted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:layout_marginBottom="6dp" />

                        <!-- Trim Transparent Borders -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingVertical="4dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Trim transparent borders"
                                    android:textColor="@color/vf_text_primary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Crops empty margin space around cutout"
                                    android:textColor="@color/vf_text_secondary"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchTrimTransparent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="false" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Backdrop & Export Selector Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <!-- Backdrop Mode -->
                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupBgBackdrop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipBackdropTransparent"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Transparent" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipBackdropWhite"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="White BG" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipBackdropBlack"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Black BG" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Export Format Toggle -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupBgExportFormat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFormatPng"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="PNG" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFormatJpg"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="JPG" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>
        </com.veilframe.app.ui.MaxHeightNestedScrollView>

        <!-- Action Dock -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBgActionDock"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/vf_surface_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBgChangeImage"
                    style="@style/Widget.VeilFrame.IconButton.Toolbar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Change Photo"
                    app:icon="@drawable/ic_tab_image"
                    app:iconSize="20dp"
                    app:iconTint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBgExecuteRemoval"
                        style="@style/Widget.VeilFrame.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="Remove Background"
                        app:icon="@drawable/ic_eraser"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBgRefineBrush"
                        style="@style/Widget.VeilFrame.Button.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone"
                        android:text="Refine Brush"
                        app:icon="@drawable/ic_brush"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBgSavePng"
                        style="@style/Widget.VeilFrame.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone"
                        android:text="Save Cutout"
                        app:icon="@drawable/ic_action_save"
                        app:iconSize="18dp" />
                </LinearLayout>

                <Space
                    android:id="@+id/spaceBgActionDockBalance"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Dedicated Picsart-Style Refine Brush Dock (Visible when in Manual Brush Mode) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBgRefineDock"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/vf_surface_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Row 1: Tool Selection (Erase vs Restore) & Undo/Redo & Reset Zoom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleGroupBrushMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeErase"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Erase"
                            app:icon="@drawable/ic_eraser"
                            app:iconSize="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnModeRestore"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Restore"
                            app:icon="@drawable/ic_brush"
                            app:iconSize="16dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefineUndo"
                        style="@style/Widget.VeilFrame.IconButton.Toolbar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Undo stroke"
                        app:icon="@drawable/ic_undo"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefineRedo"
                        style="@style/Widget.VeilFrame.IconButton.Toolbar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Redo stroke"
                        app:icon="@drawable/ic_redo"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefineResetZoom"
                        style="@style/Widget.VeilFrame.IconButton.Toolbar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Reset zoom"
                        app:icon="@drawable/ic_reset"
                        app:iconSize="18dp" />
                </LinearLayout>

                <!-- Row 2: Brush Size Slider with real-time HUD preview -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_brush"
                        app:tint="@color/vf_text_muted"
                        android:contentDescription="Brush Size" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBrushSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:valueFrom="4.0"
                        android:valueTo="120.0"
                        android:value="30.0"
                        android:stepSize="2.0" />

                    <TextView
                        android:id="@+id/tvBrushSizeVal"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="30 px"
                        android:textColor="@color/vf_text_secondary"
                        android:textSize="12sp"
                        android:gravity="end" />
                </LinearLayout>

                <!-- Row 3: Action Buttons (Cancel vs Done) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefineCancel"
                        style="@style/Widget.VeilFrame.Button.Action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="Cancel"
                        app:icon="@drawable/ic_close"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRefineDone"
                        style="@style/Widget.VeilFrame.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="Apply Refinement"
                        app:icon="@drawable/ic_done"
                        app:iconSize="16dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
