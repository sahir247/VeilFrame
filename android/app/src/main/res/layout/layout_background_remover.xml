<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutBackgroundRemoverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_bg_dark"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarBgRemover"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/vf_surface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/vf_text_primary"
            app:title="Background Remover"
            app:titleTextColor="@color/vf_text_primary"
            app:subtitle="Offline Subject Segmentation"
            app:subtitleTextColor="@color/vf_text_secondary">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBgResetCompare"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:contentDescription="Reset comparison"
                app:icon="@drawable/ic_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBgSavePng"
                style="@style/Widget.VeilFrame.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="Save PNG"
                app:icon="@drawable/ic_action_save"
                app:iconSize="18dp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Preview Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/containerBgEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_crop"
                    app:tint="@color/vf_text_secondary"
                    android:contentDescription="Select Image" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Select an Image"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Isolate foreground subjects and create clean transparent cutouts on-device."
                    android:textColor="@color/vf_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBgPickImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Choose Image"
                    app:icon="@drawable/ic_tab_image" />
            </LinearLayout>

            <!-- Interactive Before/After Split Comparison View -->
            <com.veilframe.app.ui.views.BeforeAfterSplitView
                android:id="@+id/splitViewBgCompare"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Backdrop & Refinement Controls Strip (Visible when image is loaded) -->
        <LinearLayout
            android:id="@+id/containerBgControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <!-- Backdrop Mode -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupBgBackdrop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBackdropTransparent"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Transparent" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBackdropWhite"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="White Backdrop" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBackdropBlack"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Black Backdrop" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Edge Refinement Mode -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="2dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupBgRefinement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRefineLow"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fast Edge" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRefineBalanced"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Balanced Edge" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRefineHigh"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Precision Edge" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Action Dock -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBgActionDock"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/vf_surface_stroke">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBgChangeImage"
                    style="@style/Widget.VeilFrame.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Change Image"
                    app:icon="@drawable/ic_tab_image"
                    app:iconSize="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBgExecuteRemoval"
                    style="@style/Widget.VeilFrame.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove Background"
                    app:icon="@drawable/ic_crop"
                    app:iconSize="18dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
