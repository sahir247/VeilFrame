<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutBackgroundRemoverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_background"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarBgRemover"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/vf_surface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/vf_text_primary"
            app:title="Background Remover"
            app:titleTextColor="@color/vf_text_primary"
            app:subtitle="Offline Subject Segmentation"
            app:subtitleTextColor="@color/vf_text_secondary">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBgSavePng"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:layout_marginEnd="16dp"
                android:text="Save PNG"
                android:textSize="12sp"
                app:icon="@drawable/ic_action_save"
                app:iconSize="16dp" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Preview Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/containerBgEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_crop"
                    app:tint="@color/vf_text_secondary"
                    android:contentDescription="Select Image" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Select an Image"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Isolate foreground subjects and create clean transparent cutouts on-device."
                    android:textColor="@color/vf_text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBgPickImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Choose Image"
                    app:icon="@drawable/ic_tab_image" />
            </LinearLayout>

            <!-- Segmentation Preview -->
            <ImageView
                android:id="@+id/ivBgResultPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="Background Removal Result" />
        </FrameLayout>

        <!-- Action Dock -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBgActionDock"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/vf_surface_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBgChangeImage"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Change Image"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_tab_image"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBgExecuteRemoval"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Remove Background"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_crop"
                    app:iconSize="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
