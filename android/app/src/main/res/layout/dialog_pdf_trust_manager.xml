<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vf_surface"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vf_surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="Trust Store"
            android:src="@drawable/ic_certificate"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trusted Certificate Store"
                android:textColor="@color/vf_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PKI Trust Anchors &amp; User Pins"
                android:textColor="@color/vf_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTrustManagerClose"
            style="@style/Widget.VeilFrame.IconButton.Toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Close"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/vf_text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="450dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Bundled PKI Root Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUNDLED ROOT AUTHORITIES"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:text="Pre-bundled root certificates for Controller of Certifying Authorities (CCA India 2014, 2015-SPL, 2022) and nCode Solutions intermediates."
                android:textColor="@color/vf_text_secondary"
                android:textSize="12sp" />

            <!-- Bundled Roots List -->
            <LinearLayout
                android:id="@+id/containerBundledRoots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical" />

            <!-- User Pinned Certificates Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USER TRUSTED CERTIFICATES &amp; PINS"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerUserPins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmptyUserPins"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No user-trusted signer certificates pinned yet."
                    android:textColor="@color/vf_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportCaCert"
                style="@style/Widget.VeilFrame.Button.Action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Import Root CA (.pem, .crt)"
                app:icon="@drawable/ic_folder_open" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTrustManagerDismiss"
                style="@style/Widget.VeilFrame.Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Close"
                android:textColor="@color/vf_text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
