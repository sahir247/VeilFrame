<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vf_surface"
    android:orientation="vertical">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/vf_surface_variant">

        <TextView
            android:id="@+id/tvWatermarkDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Text Watermark &amp; Overlay"
            android:textColor="@color/vf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatermarkClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close Watermark Dialog"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/vf_text_secondary" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="480dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Live Preview of Watermark -->
            <FrameLayout
                android:id="@+id/watermarkPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/vf_bg_dark"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/imgWatermarkPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Watermark Preview" />
            </FrameLayout>

            <!-- Watermark Text Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilWatermarkText"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:hint="Watermark Text"
                app:boxStrokeColor="@color/vf_primary"
                app:hintTextColor="@color/vf_primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etWatermarkText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Quick Text Presets -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupWatermarkPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWmConfidential"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CONFIDENTIAL" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWmDraft"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DRAFT" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWmCopy"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COPY" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWmDoNotShare"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DO NOT SHARE" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Position Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="POSITION"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupWatermarkPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPosBottomRight"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bottom-Right"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPosBottomLeft"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bottom-Left" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPosTopRight"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top-Right" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPosTopLeft"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Top-Left" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipPosCenter"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Center" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Font Size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Font Size:"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWatermarkSizeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="32 sp"
                    android:textColor="@color/vf_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderWatermarkSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="14"
                android:valueTo="72"
                android:value="32"
                android:stepSize="2"
                app:thumbColor="@color/vf_primary"
                app:trackColorActive="@color/vf_primary"
                app:trackColorInactive="@color/vf_surface_variant" />

            <!-- Color Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="6dp"
                android:text="TEXT COLOR"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupWatermarkColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWmColorWhite"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="White"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWmColorBlack"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Black" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWmColorRed"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Red" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWmColorYellow"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yellow" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/vf_surface_variant">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatermarkReset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Clear"
            android:textColor="@color/vf_text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatermarkCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Cancel"
            android:textColor="@color/vf_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWatermarkApply"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Apply"
            android:textColor="@color/vf_on_primary"
            app:backgroundTint="@color/vf_primary" />
    </LinearLayout>
</LinearLayout>
