<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMergeFile"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/vf_container"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/vf_surface_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- First Page Thumbnail Preview -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="52dp"
            android:layout_height="68dp"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/vf_surface_variant"
            app:strokeWidth="1dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF">

                <ImageView
                    android:id="@+id/ivMergeThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />

                <ProgressBar
                    android:id="@+id/pbMergeThumb"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Document Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvMergeSequence"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pdf_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="#1"
                    android:textColor="@color/vf_on_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvMergeFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="document.pdf"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@color/vf_text_primary"
                    android:ellipsize="middle"
                    android:singleLine="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMergeFileMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 pages • 2.4 MB"
                android:textSize="11sp"
                android:textColor="@color/vf_text_secondary"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Arrange Controls: Move Up, Move Down, Remove -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnMergeMoveUp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Move Up"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/vf_text_primary" />

            <ImageButton
                android:id="@+id/btnMergeMoveDown"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Move Down"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/vf_text_primary" />

            <ImageButton
                android:id="@+id/btnMergeRemove"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove File"
                android:src="@drawable/ic_close"
                app:tint="@color/vf_text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
