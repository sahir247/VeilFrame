<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vf_surface"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/vf_surface_variant">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Choose Upscale Model"
            android:textColor="@color/vf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModelSelectorClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/vf_text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="460dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <RadioGroup
                android:id="@+id/rgModelSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbModelAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Auto (Preset Recommended)\nSelects the optimal model for the current preset"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/vf_surface_stroke"
                    android:layout_marginVertical="6dp" />

                <RadioButton
                    android:id="@+id/rbModelRealEsrgan2x"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Real-ESRGAN General 2× (AI • 33.8 MB)\nOptimized for real photos, textures, balanced performance"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbModelRealEsrgan4x"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Real-ESRGAN General 4× (AI • 33.8 MB)\nReliable general-purpose photo restoration"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbModelRealEsrganAnime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Real-ESRGAN Anime 4× (AI • 9.1 MB)\nUltra-clean lines and vibrant tones for anime and art"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/vf_surface_stroke"
                    android:layout_marginVertical="6dp" />

                <RadioButton
                    android:id="@+id/rbModelLanczos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Lanczos (3-Lobe) (Built-in • 0 MB)\nMathematical sinc reconstruction with edge preservation"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbModelBicubic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Bicubic Spline (Built-in • 0 MB)\nSmooth cubic interpolation for soft gradients"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbModelNearest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:text="Nearest Neighbor (Built-in • 0 MB)\nPixel-exact scaling without blurring; ideal for pixel art"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp" />
            </RadioGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnModelSelectorApply"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Select Model"
                android:textColor="@color/vf_on_primary"
                app:backgroundTint="@color/vf_primary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
