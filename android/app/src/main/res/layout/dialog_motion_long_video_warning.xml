<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvWarningMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Processing videos longer than 30 seconds requires intense on-device neural synthesis. This can cause high device temperatures, lag, and extended render times."
        android:textAppearance="@style/TextAppearance.VeilFrame.Body"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbDoNotShowAgain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Do not show again"
        android:textAppearance="@style/TextAppearance.VeilFrame.Body.Sub"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>

