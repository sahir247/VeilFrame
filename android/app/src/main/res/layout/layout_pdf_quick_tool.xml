<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPdfQuickToolRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarPdfQuickTool"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/vf_text_primary"
            app:title="PDF Operation"
            app:titleTextColor="@color/vf_text_primary"
            app:subtitle="Offline Processing"
            app:subtitleTextColor="@color/vf_text_secondary">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPdfQuickToolReset"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:contentDescription="Close Document"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/vf_text_secondary" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Main Scroller -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPdfQuickTool"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Document / File Picker Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuickToolPicker"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/vf_surface_variant"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/containerQuickToolEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:id="@+id/ivQuickToolPickIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_pdf_file"
                            app:tint="@color/vf_secondary" />

                        <TextView
                            android:id="@+id/tvQuickToolPickPrompt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Select Document"
                            android:textColor="@color/vf_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvQuickToolPickSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Tap to browse local device storage"
                            android:textColor="@color/vf_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerQuickToolDocInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_pdf_file" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvQuickToolDocName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="document.pdf"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="@color/vf_text_primary"
                                android:ellipsize="middle"
                                android:singleLine="true" />

                            <TextView
                                android:id="@+id/tvQuickToolDocMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10 pages • 1.8 MB"
                                android:textSize="12sp"
                                android:textColor="@color/vf_text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnQuickToolChangeDoc"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Multi-file list container for Merge PDF -->
                <LinearLayout
                    android:id="@+id/containerMultiFileList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvMultiFileCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECTED FILES (0)"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <LinearLayout
                        android:id="@+id/layoutFilesItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddMoreFiles"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Add Another File"
                        app:icon="@drawable/ic_add" />
                </LinearLayout>

                <!-- 2. DYNAMIC PARAMETER PANELS -->

                <!-- Panel A: COMPRESS PDF -->
                <LinearLayout
                    android:id="@+id/panelParamCompress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COMPRESSION ENGINE"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCompressEngine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCompressImages"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Image Optimization (Preserve Vectors)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCompressFullRender"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Full Re-Render (Maximum Shrink)" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="QUALITY / TARGET PROFILE"
                            android:textColor="@color/vf_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompressQualityVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Balanced (65%)"
                            android:textStyle="bold"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderCompressQuality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="20.0"
                        android:valueTo="90.0"
                        android:value="65.0"
                        android:stepSize="5.0" />
                </LinearLayout>

                <!-- Panel B: LOCK PDF -->
                <LinearLayout
                    android:id="@+id/panelParamLock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilLockPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Set Password (AES-256)"
                        app:endIconMode="password_toggle"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLockPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DOCUMENT PERMISSIONS"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbLockAllowPrint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Allow High-Quality Printing" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbLockAllowCopy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="Allow Content Copying &amp; Extraction" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbLockAllowAnnotate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="Allow Annotations &amp; Commenting" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbLockAllowFillForms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Allow Interactive Form Filling" />
                </LinearLayout>

                <!-- Panel C: ROTATE / REORDER / DELETE -->
                <LinearLayout
                    android:id="@+id/panelParamRotate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROTATION ANGLE"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupRotateAngle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRotate90"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="90° Clockwise" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRotate180"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="180° Half Turn" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipRotate270"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="270° Counter-Clockwise" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilRotatePages"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Pages to Rotate (leave blank for all)"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRotatePages"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Panel D: SIGN PDF (Touch Bézier Drawing Canvas) -->
                <LinearLayout
                    android:id="@+id/panelParamSign"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DRAW SIGNATURE"
                            android:textColor="@color/vf_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSignClear"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Clear" />
                    </LinearLayout>

                    <!-- Touch Canvas -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/vf_surface_variant"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="12dp">

                        <com.veilframe.app.pdf.ui.SignaturePadView
                            android:id="@+id/viewSignaturePad"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/vf_container" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PLACEMENT POSITION"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSignPlacement"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlacementBottomRight"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Bottom Right" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlacementBottomCenter"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bottom Center" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPlacementBottomLeft"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bottom Left" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <!-- Panel E: METADATA INSPECTOR & STRIPPER -->
                <LinearLayout
                    android:id="@+id/panelParamMetadata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Title">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMetaTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Author">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMetaAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Keywords / Tags">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etMetaKeywords"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStripAllMetadata"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sanitize &amp; Strip All Forensic Traces"
                        app:icon="@drawable/ic_exif" />
                </LinearLayout>

                <!-- Panel F: HTML / DOC SOURCE INPUT -->
                <LinearLayout
                    android:id="@+id/panelParamSourceInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSourceInput"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Web URL or Raw HTML Content">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSourceInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minLines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Execute Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnQuickToolExecute"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="32dp"
                    android:text="Execute Operation"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_action_save" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
