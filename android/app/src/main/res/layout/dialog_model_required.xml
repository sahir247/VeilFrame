<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vf_surface"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/vf_surface_variant">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Model Required"
            android:textColor="@color/vf_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModelReqClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/vf_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvModelReqTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-ESRGAN General 2× is required"
            android:textColor="@color/vf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvModelReqMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This preset uses an AI neural model (33.8 MB) that is not downloaded yet. Would you like to download it now to proceed?"
            android:textColor="@color/vf_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressModelReq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/vf_primary"
            app:trackColor="@color/vf_surface_variant" />

        <TextView
            android:id="@+id/tvModelReqProgressStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Downloading..."
            android:textColor="@color/vf_accent_blue"
            android:textSize="12sp"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModelReqDownload"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Download &amp; Upscale"
            android:textColor="@color/vf_on_primary"
            app:backgroundTint="@color/vf_primary"
            app:icon="@drawable/ic_system_update"
            app:iconTint="@color/vf_on_primary"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModelReqUseLanczos"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Use Built-in Lanczos Instead"
            android:textColor="@color/vf_text_primary"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModelReqCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Cancel"
            android:textColor="@color/vf_text_secondary" />
    </LinearLayout>
</LinearLayout>
