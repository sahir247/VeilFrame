<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/vf_surface"
    android:orientation="vertical">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:background="@color/vf_surface_variant">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Target Size &amp; Compression"
            android:textColor="@color/vf_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
        android:ellipsize="end"
        android:singleLine="true"
        android:maxLines="1"
            android:id="@+id/btnVideoPresetClose"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Close Target Size Dialog"
            app:icon="@drawable/ic_close"
            app:iconTint="@color/vf_text_secondary" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxHeight="440dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Automatically calculates exact 2-pass bitrate to fit messaging platform limits."
                android:textColor="@color/vf_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="PLATFORM SIZE LIMITS"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <!-- Platform presets -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTargetSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPresetAuto"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto (Balanced CRF 28)"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPresetWhatsapp"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WhatsApp Status" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPresetDiscord"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discord (25 MB)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPresetNitro"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Discord Nitro (50 MB)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPresetEmail"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email Attachment (8 MB)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPresetWeb"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Web Stream (10 MB)" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Video Codecs -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="VIDEO CODEC"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupVideoCodecDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCodecH264"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H.264 (Universal)"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCodecH265"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="H.265 / HEVC" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCodecVp9"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VP9" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCodecCopy"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy Stream" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Container Format -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="OUTPUT CONTAINER"
                android:textColor="@color/vf_text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupVideoContainerDialog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipContainerMp4"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MP4"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipContainerMov"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOV" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipContainerMkv"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MKV" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipContainerWebm"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WebM" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipContainerAvi"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AVI" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipContainerGif"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GIF" />
            </com.google.android.material.chip.ChipGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Constant Rate Factor (CRF):"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCrfValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="28"
                    android:textColor="@color/vf_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderCrf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="18"
                android:valueTo="38"
                android:value="28"
                android:stepSize="1"
                app:thumbColor="@color/vf_primary"
                app:trackColorActive="@color/vf_primary"
                app:trackColorInactive="@color/vf_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lower CRF = Higher Quality / Larger File. Higher CRF = High Compression."
                android:textColor="@color/vf_text_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Fixed Bottom Action Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="@color/vf_surface_variant">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoPresetReset"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Reset"
            android:textColor="@color/vf_text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoPresetCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="8dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Cancel"
            android:textColor="@color/vf_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVideoPresetApply"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Apply"
            android:textColor="@color/vf_on_primary"
            app:backgroundTint="@color/vf_primary" />
    </LinearLayout>
</LinearLayout>
