<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPdfWatermarkRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarPdfWatermark"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:title="Watermark Studio"
            app:titleTextColor="?attr/colorOnSurface"
            app:subtitle="Tamper-Proof Live Security Patterns"
            app:subtitleTextColor="?attr/colorOnSurfaceVariant">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPdfWatermarkReset"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:contentDescription="Close PDF"
                app:icon="@drawable/ic_close"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Main Scroller -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPdfWatermark"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Document Picker & Metadata Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWatermarkPicker"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/vf_surface_variant"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/containerWatermarkEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_color_filter"
                            app:tint="@color/vf_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Select PDF to Watermark"
                            android:textColor="@color/vf_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Supports real-time preview and multi-angle mesh protection"
                            android:textColor="@color/vf_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerWatermarkDocInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_pdf_file" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvWatermarkDocName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="document.pdf"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="@color/vf_text_primary"
                                android:ellipsize="middle"
                                android:singleLine="true" />

                            <TextView
                                android:id="@+id/tvWatermarkDocMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12 pages • 2.4 MB"
                                android:textSize="12sp"
                                android:textColor="@color/vf_text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnWatermarkChangeDoc"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Live Preview Section (Visible once document is picked) -->
                <LinearLayout
                    android:id="@+id/containerWatermarkControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Live Page Preview Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardWatermarkPreview"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/vf_surface_variant"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="LIVE PREVIEW"
                                    android:textColor="@color/vf_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />

                                <TextView
                                    android:id="@+id/tvWatermarkPageIndicator"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Page 1 of 1"
                                    android:textSize="12sp"
                                    android:textColor="@color/vf_text_secondary" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="320dp"
                                android:background="@color/vf_container">

                                <ImageView
                                    android:id="@+id/ivWatermarkPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter" />

                                <ProgressBar
                                    android:id="@+id/pbWatermarkPreviewLoading"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone" />
                            </FrameLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Watermark Text Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilWatermarkText"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Watermark Text"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etWatermarkText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="CONFIDENTIAL"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Fill Pattern Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROTECTION PATTERN"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupWatermarkPattern"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPatternCenter"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Center" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPatternDiagonalAsc"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Diagonal ↗" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPatternDiagonalDesc"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Diagonal ↘" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPatternHorizontal"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Horizontal ═" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPatternVertical"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vertical ║" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPatternMesh"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Security Mesh ✕" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Opacity Slider -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OPACITY"
                            android:textColor="@color/vf_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tvWatermarkOpacityVal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="25%"
                            android:textStyle="bold"
                            android:textColor="@color/vf_text_primary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderWatermarkOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="5.0"
                        android:valueTo="100.0"
                        android:value="25.0"
                        android:stepSize="5.0"
                        android:layout_marginBottom="16dp" />

                    <!-- Font Size & Angle Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="FONT SIZE"
                                    android:textColor="@color/vf_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvWatermarkFontSizeVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="36 pt"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderWatermarkFontSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="14.0"
                                android:valueTo="72.0"
                                android:value="36.0"
                                android:stepSize="2.0" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="ROTATION"
                                    android:textColor="@color/vf_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvWatermarkAngleVal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="45°"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderWatermarkAngle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:valueFrom="-90.0"
                                android:valueTo="90.0"
                                android:value="45.0"
                                android:stepSize="5.0" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Export Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWatermarkApplyExport"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="32dp"
                        android:text="Apply Watermark &amp; Export"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_action_save" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
