<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutDocumentScannerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:visibility="gone">

    <!-- Normal Content Layer: Toolbar + Empty State / Page Manager -->
    <LinearLayout
        android:id="@+id/containerDocMainFlow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDocScanner"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="?attr/colorOnSurface"
            app:contentInsetStartWithNavigation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvDocScannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Document Scanner"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvDocScannerSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Multi-Page Intake &amp; PDF Export"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDocExportPdf"
                    style="@style/Widget.VeilFrame.Button.Utility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Export"
                    android:textSize="12sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_action_save"
                    app:iconSize="16dp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Main Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 1. Empty State (Start Scan or Import) -->
            <LinearLayout
                android:id="@+id/containerDocEmptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/vf_text_secondary"
                    android:contentDescription="No Scans" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No Document Pages"
                    android:textColor="@color/vf_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Capture with live camera edge detection or import photos from storage to create multi-page documents."
                    android:textColor="@color/vf_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDocEmptyCamera"
                        style="@style/Widget.VeilFrame.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Camera"
                        app:iconGravity="textStart"
                        app:icon="@drawable/ic_camera" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDocEmptyImport"
                        style="@style/Widget.VeilFrame.Button.Utility"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="Import"
                        app:iconGravity="textStart"
                        app:icon="@drawable/ic_tab_image" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Real Page Manager & Multi-Page Document Workspace with Embedded Image Studio -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/containerDocPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="96dp">

                    <!-- Large Selected Page Preview -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/ivDocPagePreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="Scanned Page Preview - Tap to edit crop" />

                        <!-- Floating Page Indicator Badge -->
                        <TextView
                            android:id="@+id/tvDocPageIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|end"
                            android:background="?attr/colorSurfaceContainer"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="Page 1 of 1"
                            android:textColor="@color/vf_text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <!-- Visual Horizontal Thumbnail Strip -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDocThumbnails"
                        android:layout_width="match_parent"
                        android:layout_height="92dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                    <!-- Page Operations Strip (Move Left, Move Right, Rotate, Crop, Duplicate, Reset Crop, Delete) -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:fillViewport="false"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDocPageMoveLeft"
                                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Move Left"
                                app:icon="@drawable/ic_arrow_back" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDocPageMoveRight"
                                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Move Right"
                                app:icon="@drawable/ic_arrow_forward" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDocPageRotate"
                                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Rotate 90"
                                app:icon="@drawable/ic_rotate" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDocPageCrop"
                                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Adjust Crop Corners"
                                app:icon="@drawable/ic_crop" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDocPageResetCrop"
                                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Reset Crop"
                                app:icon="@drawable/ic_reset" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDocPageDuplicate"
                                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Duplicate Page"
                                app:icon="@drawable/ic_action_copy" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDocPageDelete"
                                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="Delete Page"
                                app:icon="@drawable/ic_action_clear"
                                app:iconTint="@color/vf_accent_red" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp"
                        android:background="?attr/colorOutlineVariant" />

                    <!-- INLINE IMAGE STUDIO: FILTERS & COLOR PALETTE -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Filter &amp; Palette"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupDocFilters"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterOriginal"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Original" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterEnhanced"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Enhanced" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterBw"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="B&amp;W" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterGrayscale"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Grayscale" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterReceipt"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Receipt" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterIdDoc"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ID Doc" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterSepia"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sepia" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterVintage"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Vintage" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterCool"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cool" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFilterWarm"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Warm" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- INLINE IMAGE STUDIO: FINE TUNING -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginTop="8dp"
                        android:text="Fine Tuning"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Exposure (stops)"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocExposure"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="-2.0"
                            android:valueTo="2.0"
                            android:stepSize="0.1"
                            android:value="0.0" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Contrast"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocContrast"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.5"
                            android:valueTo="2.0"
                            android:stepSize="0.05"
                            android:value="1.0" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Saturation"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocSaturation"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.0"
                            android:valueTo="2.0"
                            android:stepSize="0.05"
                            android:value="1.0" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Warmth / Temperature"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocWarmth"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="-1.0"
                            android:valueTo="1.0"
                            android:stepSize="0.1"
                            android:value="0.0" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Text Sharpness"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocSharpen"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.0"
                            android:valueTo="2.0"
                            android:stepSize="0.1"
                            android:value="0.0" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Denoise / Clean"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocDenoise"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="0.0"
                            android:valueTo="10.0"
                            android:stepSize="1.0"
                            android:value="0.0" />
                    </LinearLayout>

                    <!-- INLINE IMAGE STUDIO: DOCUMENT WATERMARK & STAMP -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="Document Watermark &amp; Stamp"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:hint="Watermark Text (e.g. CONFIDENTIAL)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etDocWatermarkText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textCapCharacters"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Quick Stamp Presets -->
                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocWmConfidential"
                                    style="@style/Widget.Material3.Chip.Assist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="CONFIDENTIAL" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocWmCopy"
                                    style="@style/Widget.Material3.Chip.Assist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="COPY" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocWmDraft"
                                    style="@style/Widget.Material3.Chip.Assist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="DRAFT" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocWmDoNotShare"
                                    style="@style/Widget.Material3.Chip.Assist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="DO NOT SHARE" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <!-- Watermark Position -->
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Position"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupDocWmPosition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:singleLine="true"
                                app:singleSelection="true">

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocPosBottomRight"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bottom Right" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocPosCenter"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Center" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocPosTopRight"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Top Right" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocPosTopLeft"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Top Left" />

                                <com.google.android.material.chip.Chip
                                    android:id="@+id/chipDocPosBottomLeft"
                                    style="@style/Widget.Material3.Chip.Filter"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bottom Left" />
                            </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>

                        <!-- Watermark Size & Opacity -->
                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Watermark Size"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocWmSize"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="12.0"
                            android:valueTo="72.0"
                            android:stepSize="2.0"
                            android:value="28.0" />

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Watermark Opacity"
                            android:textAppearance="@style/TextAppearance.VeilFrame.Label" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderDocWmOpacity"
                            style="@style/Widget.VeilFrame.Slider"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:valueFrom="10.0"
                            android:valueTo="100.0"
                            android:stepSize="5.0"
                            android:value="60.0" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDocResetAdjustments"
                            style="@style/Widget.VeilFrame.Button.Utility"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="16dp"
                            android:text="Reset Adjustments"
                            app:icon="@drawable/ic_reset" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>

        <!-- Bottom Actions Dock (Floating Pill) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDocActionDock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:strokeColor="@color/vf_surface_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDocAddCamera"
                    style="@style/Widget.VeilFrame.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="+ Camera"
                    app:icon="@drawable/ic_camera"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDocAddPhotos"
                    style="@style/Widget.VeilFrame.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:text="+ Photos"
                    app:icon="@drawable/ic_tab_image"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDocAutoDetect"
                    style="@style/Widget.VeilFrame.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:text="Auto Crop"
                    app:icon="@drawable/ic_crop"
                    app:iconSize="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Dedicated Fullscreen CameraX Document Camera Screen -->
    <FrameLayout
        android:id="@+id/containerDocCamera"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone">

        <!-- CameraX Viewfinder -->
        <androidx.camera.view.PreviewView
            android:id="@+id/docCameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:implementationMode="compatible" />

        <!-- Live Detected Document Quad Canvas -->
        <com.veilframe.app.ui.views.DocumentQuadOverlayView
            android:id="@+id/docQuadOverlayView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top Camera Header Overlay -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="#77000000"
            android:padding="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDocCamClose"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Close Camera"
                app:icon="@drawable/ic_close"
                app:iconTint="@android:color/white" />

            <ImageView
                android:id="@+id/ivDocCamStatusIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_crop"
                app:tint="#CCFFFFFF" />

            <TextView
                android:id="@+id/tvDocCamStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Align document inside frame"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDocCamFlip"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:contentDescription="Flip Camera"
                app:icon="@drawable/ic_rotate"
                app:iconTint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDocCamFlash"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Toggle Flash"
                app:icon="@drawable/ic_flash_off"
                app:iconTint="@android:color/white" />
        </LinearLayout>

        <!-- Tap-to-Focus Animated Ring Overlay -->
        <ImageView
            android:id="@+id/ivDocCamFocusRing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_focus_ring"
            android:visibility="gone"
            android:contentDescription="Focus Ring" />

        <!-- Floating Camera Zoom Presets Bar -->
        <LinearLayout
            android:id="@+id/containerDocCamZoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="116dp"
            android:background="@drawable/bg_pill_accent"
            android:backgroundTint="#88000000"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/btnDocZoomHalf"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="0.5x"
                android:textColor="@color/vf_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnDocZoom1x"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="1x"
                android:textColor="@color/vf_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnDocZoom2x"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="2x"
                android:textColor="@color/vf_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Bottom Camera Action Overlay (Rapid Multi-Capture & Shutter) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#99000000"
            android:padding="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDocCamImport"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Import Photos"
                app:icon="@drawable/ic_tab_image"
                app:iconTint="@android:color/white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Rapid Multi-Capture Shutter Button -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnDocCamShutter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabCustomSize="72dp"
                app:backgroundTint="@android:color/white"
                app:tint="@color/vf_bg_dark"
                app:srcCompat="@drawable/ic_camera"
                android:contentDescription="Take Scan" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Done / Page Counter Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDocCamDone"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:contentDescription="Done"
                app:icon="@drawable/ic_done"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@android:color/white" />
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
