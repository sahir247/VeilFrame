<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutPdfImpositionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarPdfImposition"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/vf_text_primary"
            app:title="Print Imposition Studio"
            app:titleTextColor="@color/vf_text_primary"
            app:subtitle="Booklets, N-Up &amp; Mini-Zines"
            app:subtitleTextColor="@color/vf_text_secondary">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPdfImpositionReset"
                style="@style/Widget.VeilFrame.IconButton.Toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:contentDescription="Close PDF"
                app:icon="@drawable/ic_close"
                app:iconTint="@color/vf_text_secondary" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Main Scroller -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollPdfImposition"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. Document Picker & Metadata Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardImpositionPicker"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="@color/vf_surface_variant"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/containerImpositionEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_print"
                            app:tint="@color/vf_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="Select PDF for Print Imposition"
                            android:textColor="@color/vf_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Automatically arranges pages for physical double-sided folding, binding &amp; booklets"
                            android:textColor="@color/vf_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerImpositionDocInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_pdf_file" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvImpositionDocName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="manuscript.pdf"
                                android:textStyle="bold"
                                android:textSize="14sp"
                                android:textColor="@color/vf_text_primary"
                                android:ellipsize="middle"
                                android:singleLine="true" />

                            <TextView
                                android:id="@+id/tvImpositionDocMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16 pages • 4.2 MB"
                                android:textSize="12sp"
                                android:textColor="@color/vf_text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImpositionChangeDoc"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Change" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. Controls Section -->
                <LinearLayout
                    android:id="@+id/containerImpositionControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Live Sheet Preview Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardImpositionPreview"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:strokeColor="@color/vf_surface_variant"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginBottom="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="LIVE SHEET PREVIEW"
                                    android:textColor="@color/vf_secondary"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />

                                <TextView
                                    android:id="@+id/tvImpositionSheetIndicator"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Sheet 1 of 1"
                                    android:textSize="12sp"
                                    android:textColor="@color/vf_text_secondary" />
                            </LinearLayout>

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="280dp"
                                android:background="@color/vf_container"
                                android:padding="8dp">

                                <ImageView
                                    android:id="@+id/ivImpositionPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:contentDescription="Imposed Sheet Preview" />

                                <ProgressBar
                                    android:id="@+id/pbImpositionLoading"
                                    android:layout_width="36dp"
                                    android:layout_height="36dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <!-- Sheet Navigation Buttons -->
                            <LinearLayout
                                android:id="@+id/containerImpositionSheetNav"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="8dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnImpositionPrevSheet"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Previous"
                                    app:icon="@drawable/ic_arrow_back" />

                                <TextView
                                    android:id="@+id/tvImpositionSheetCount"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:text="Sheet 1 / 1"
                                    android:textStyle="bold"
                                    android:textSize="12sp"
                                    android:textColor="@color/vf_text_primary" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnImpositionNextSheet"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Next"
                                    app:icon="@drawable/ic_arrow_forward"
                                    app:iconGravity="end" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Imposition Layout Mode -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMPOSITION SCHEME"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupImpositionScheme"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSchemeBooklet"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Saddle Stitch Booklet" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipScheme2Up"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2-Up (Side-by-Side)" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipScheme4Up"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="4-Up (Grid)" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSchemeCutStack"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cut &amp; Stack" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSchemeMiniZine"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8-Page Mini-Zine" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Paper Size Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET SHEET SIZE"
                        android:textColor="@color/vf_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupImpositionPaperSize"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPaperA4"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="A4 (210 × 297 mm)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPaperLetter"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Letter (8.5 × 11 in)" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPaperLegal"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Legal (8.5 × 14 in)" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Guides & Cut Marks Switch -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDrawGuides"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Draw Fold Creases &amp; Cutting Guides"
                        android:textSize="13sp"
                        android:textColor="@color/vf_text_primary"
                        android:layout_marginBottom="16dp" />

                    <!-- Scheme Summary Card -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="12dp"
                        app:cardBackgroundColor="@color/vf_container"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tvImpositionPlanTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saddle-Stitch Booklet Plan"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="@color/vf_text_primary" />

                            <TextView
                                android:id="@+id/tvImpositionPlanDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="16 source pages will be imposed onto 4 physical duplex sheets (8 sheets total). Fold in half and staple along the spine."
                                android:textSize="12sp"
                                android:textColor="@color/vf_text_secondary"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Execute Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImpositionExecute"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="32dp"
                        android:text="Generate Imposed Print PDF"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_print" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
