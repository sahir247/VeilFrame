<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vf_bg_dark">

    <!-- Top App Bar with System Insets & Brand Vector Logo -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/vf_surface"
        app:elevation="4dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/imgBrandLogo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_veilframe_brand"
                    android:contentDescription="VeilFrame Shield Logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VEILFRAME"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRIVACY FORENSICS &amp; AI BUNDLER"
                        android:textColor="@color/vf_primary"
                        android:textSize="9sp"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/vf_surface_variant"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="v2.2.1"
                    android:textColor="@color/vf_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable Vertical Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="100dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Engine Mode Selector (SVG Icons, No Emojis) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SELECT ENGINE MODE"
                android:textColor="@color/vf_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeAi"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="AI Bundle"
                        app:chipIcon="@drawable/ic_tab_bundle"
                        app:chipIconTint="@color/vf_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeVideo"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Video Cleaner"
                        app:chipIcon="@drawable/ic_tab_video"
                        app:chipIconTint="@color/vf_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeImage"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Image Cleaner"
                        app:chipIcon="@drawable/ic_tab_image"
                        app:chipIconTint="@color/vf_primary" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipModeFolder"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Folder Scanner"
                        app:chipIcon="@drawable/ic_tab_folder"
                        app:chipIconTint="@color/vf_primary" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- 2. Target File / Directory Picker Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/vf_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/vf_surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvTargetHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TARGET SELECTION"
                            android:textColor="@color/vf_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearTarget"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="CLEAR"
                            android:textColor="@color/vf_text_muted"
                            android:textSize="11sp"
                            app:icon="@drawable/ic_action_clear"
                            app:iconSize="14dp"
                            app:iconTint="@color/vf_text_muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSelectedPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/vf_surface_variant"
                        android:padding="10dp"
                        android:text="No file or folder selected"
                        android:textColor="@color/vf_text_muted"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:maxLines="2"
                        android:ellipsize="middle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickFolder"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="SELECT FOLDER"
                            android:textSize="12sp"
                            android:textColor="@color/vf_on_primary"
                            app:icon="@drawable/ic_folder_pick"
                            app:iconTint="@color/vf_on_primary"
                            app:iconSize="16dp"
                            app:backgroundTint="@color/vf_primary"
                            app:cornerRadius="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickFile"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="SELECT FILE"
                            android:textSize="12sp"
                            android:textColor="@color/vf_primary"
                            app:icon="@drawable/ic_file_pick"
                            app:iconTint="@color/vf_primary"
                            app:iconSize="16dp"
                            app:strokeColor="@color/vf_primary"
                            app:cornerRadius="8dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Engine Parameters Card (Adapts to Selected Mode) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/vf_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/vf_surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvParamHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BUNDLE CONFIGURATION"
                        android:textColor="@color/vf_text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <!-- Section A: Primary Selector (Budget in AI mode, Noise in Video, Format in Image, Mode in Folder) -->
                    <TextView
                        android:id="@+id/tvPrimaryOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Token Budget Limit:"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <HorizontalScrollView
                        android:id="@+id/scrollPrimaryOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupPrimaryOptions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOption1"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="32,000" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOption2"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="64,000" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOption3"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="128,000" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOption4"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="200,000" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipOption5"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Unlimited" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Section B: Export Format Selector (Multiformat Export) -->
                    <TextView
                        android:id="@+id/tvFormatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Export Format Target:"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp" />

                    <HorizontalScrollView
                        android:id="@+id/scrollFormatOptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFormat1"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text=".aibundle" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFormat2"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Markdown (.md)" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFormat3"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="JSON (.json)" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFormat4"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ZIP Archive (.zip)" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFormat5"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HTML (.html)" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipFormat6"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Plain Text (.txt)" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Section C: Feature Switches -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchParam1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Mask potential secrets &amp; tokens"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchParam2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="Exclude automated test suites"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchParam3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Strip camera model &amp; GPS location"
                        android:textColor="@color/vf_text_primary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 4. Interactive Execution Telemetry & Console -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/vf_surface"
                app:cardCornerRadius="12dp"
                app:strokeColor="@color/vf_surface_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="EXECUTION TELEMETRY"
                            android:textColor="@color/vf_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <!-- Interactive Toolbar for Telemetry -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyLogs"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_action_copy"
                            app:iconSize="16dp"
                            app:iconTint="@color/vf_text_muted"
                            android:contentDescription="Copy Logs" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearLogs"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_action_clear"
                            app:iconSize="16dp"
                            app:iconTint="@color/vf_text_muted"
                            android:contentDescription="Clear Console" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExpandLogs"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:padding="0dp"
                            app:icon="@drawable/ic_action_expand"
                            app:iconSize="16dp"
                            app:iconTint="@color/vf_text_muted"
                            android:contentDescription="Toggle Full Height" />

                        <TextView
                            android:id="@+id/tvPhaseBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@color/vf_surface_variant"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="IDLE"
                            android:textColor="@color/vf_primary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressIndicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:indeterminate="false"
                        app:trackColor="@color/vf_surface_variant"
                        app:indicatorColor="@color/vf_primary" />

                    <TextView
                        android:id="@+id/tvStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ready for execution."
                        android:textColor="@color/vf_text_primary"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp" />

                    <!-- Scrollable Telemetry Container -->
                    <androidx.core.widget.NestedScrollView
                        android:id="@+id/scrollConsole"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:background="@color/vf_console_bg"
                        android:fillViewport="true">

                        <TextView
                            android:id="@+id/tvConsoleLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:padding="10dp"
                            android:text="[INFO] VeilFrame Mobile Engine initialized.\n[INFO] Ready for execution."
                            android:textColor="@color/vf_console_text"
                            android:textSize="10sp" />
                    </androidx.core.widget.NestedScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Action Dock (Portrait Optimized) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomActionDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardBackgroundColor="@color/vf_surface"
        app:cardCornerRadius="0dp"
        app:cardElevation="16dp"
        app:strokeColor="@color/vf_surface_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExecute"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.8"
                android:layout_marginEnd="6dp"
                android:text="GENERATE BUNDLE"
                android:textColor="@color/vf_on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_action_play"
                app:iconTint="@color/vf_on_primary"
                app:iconSize="16dp"
                app:backgroundTint="@color/vf_primary"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportResult"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="6dp"
                android:text="EXPORT"
                android:textColor="@color/vf_primary"
                android:textSize="12sp"
                android:enabled="false"
                app:icon="@drawable/ic_action_save"
                app:iconTint="@color/vf_primary"
                app:iconSize="16dp"
                app:strokeColor="@color/vf_primary"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareResult"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="SHARE"
                android:textColor="@color/vf_text_primary"
                android:textSize="12sp"
                android:enabled="false"
                app:icon="@drawable/ic_action_share"
                app:iconTint="@color/vf_text_primary"
                app:iconSize="16dp"
                app:strokeColor="@color/vf_surface_stroke"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
