<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top App Bar with System Insets & Dual Mode (Home Brand vs Tool Back Bar) -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Home Screen Header Bar -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarHome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="visible"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgBrandLogo"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_veilframe_brand"
                        android:contentDescription="VeilFrame Brand Logo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VeilFrame"
                            android:textAppearance="?attr/textAppearanceTitleMediumEmphasized"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:text="Privacy Forensics &amp; AI Bundler"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>



                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSettings"
                        style="@style/Widget.VeilFrame.IconButton.Toolbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Appearance and Customization Settings"
                        app:icon="@drawable/ic_settings"
                        app:iconTint="@color/vf_primary" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>

            <!-- Dedicated Tool Header Bar (Back Navigation + Tool Title) -->
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbarTool"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:visibility="gone"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackToHome"
                        style="@style/Widget.VeilFrame.IconButton.Toolbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:contentDescription="Back to Home Dashboard"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconTint="@color/vf_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvToolTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI Bundle"
                            android:textAppearance="?attr/textAppearanceTitleLargeEmphasized"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvToolSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Package source code for LLM analysis"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvToolStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_pill"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="READY"
                        android:textColor="@color/vf_accent_green"
                        android:textSize="11sp"
                        android:textStyle="bold" />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnToolSettings"
                        style="@style/Widget.VeilFrame.IconButton.Toolbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:contentDescription="Appearance and Customization Settings"
                        app:icon="@drawable/ic_settings"
                        app:iconTint="@color/vf_primary" />
                </LinearLayout>
            </com.google.android.material.appbar.MaterialToolbar>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ================================================================= -->
    <!-- 1. HOME DASHBOARD / LAUNCHER (App Shell Hub)                      -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutHomeDashboard"
        layout="@layout/layout_home_dashboard" />

    <!-- ================================================================= -->
    <!-- 2. DEDICATED TOOL WORKFLOW SCREEN                                 -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutToolWorkflow"
        layout="@layout/layout_tool_workflow" />

    <!-- ================================================================= -->
    <!-- 4. IMAGE STUDIO WORKSPACE                                         -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutImageStudio"
        layout="@layout/layout_image_studio" />

    <!-- ================================================================= -->
    <!-- 5. VIDEO STUDIO WORKSPACE (Visual Trimmer & Video Compressor)     -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutVideoStudio"
        layout="@layout/layout_video_studio"
        tools:ignore="DuplicateIncludedIds" />

    <!-- ================================================================= -->
    <!-- 6. MARKDOWN VIEWER WORKSPACE                                      -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutMarkdownViewer"
        layout="@layout/layout_markdown_viewer" />

    <!-- ================================================================= -->
    <!-- 7. IMAGE UPSCALER WORKSPACE (AI Super-Resolution & Tiled Inference) -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubImageUpscaler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_image_upscaler" />

    <!-- ================================================================= -->
    <!-- QR STUDIO — 8th tool (Fragment host)                              -->
    <!-- ================================================================= -->
    <FrameLayout
        android:id="@+id/fragmentQrStudio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ================================================================= -->
    <!-- 8. TOOLS CATALOGUE WORKSPACE                                      -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutToolsCatalogue"
        layout="@layout/layout_tools_catalogue" />

    <!-- ================================================================= -->
    <!-- 9. LIBRARY & EXPORTS WORKSPACE                                    -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutLibrary"
        layout="@layout/layout_library" />

    <!-- ================================================================= -->
    <!-- 10. DOCUMENT SCANNER WORKSPACE                                    -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubDocumentScanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_document_scanner" />

    <!-- ================================================================= -->
    <!-- 11. BACKGROUND REMOVER WORKSPACE                                  -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubBackgroundRemover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_background_remover" />

    <!-- ================================================================= -->
    <!-- 12. IMAGE QUALITY WORKSPACE                                       -->
    <!-- ================================================================= -->
    <include
        android:id="@+id/layoutImageQuality"
        layout="@layout/layout_image_quality" />

    <!-- ================================================================= -->
    <!-- 13. PROVENANCE & VERIFY WORKSPACE                                 -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubProvenance"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_provenance" />

    <!-- ================================================================= -->
    <!-- 14. MOTION LAB WORKSPACE (optical-flow interpolation, Alpha)      -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubMotionLab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_motion_lab" />

    <!-- ================================================================= -->
    <!-- 15. PDF SIGNATURE VALIDATION WORKSPACE                            -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfSignature"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_signature" />

    <!-- ================================================================= -->
    <!-- 16. PDF UNLOCK & DECRYPTION WORKSPACE                             -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfUnlock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_unlock" />

    <!-- ================================================================= -->
    <!-- 17. PDF STUDIO HUB WORKSPACE                                      -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfStudio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_studio" />

    <!-- ================================================================= -->
    <!-- 18. PDF WATERMARK WORKSPACE                                       -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfWatermark"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_watermark" />

    <!-- ================================================================= -->
    <!-- 19. PDF EXTRACT TEXT WORKSPACE                                    -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfExtractText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_extract_text" />

    <!-- ================================================================= -->
    <!-- 20. PDF EXTRACT PAGES WORKSPACE                                   -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfExtractPages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_extract_pages" />

    <!-- ================================================================= -->
    <!-- 21. PDF FLATTEN WORKSPACE                                         -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfFlatten"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_flatten" />

    <!-- ================================================================= -->
    <!-- 22. PDF PRINT IMPOSITION STUDIO WORKSPACE                         -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfImposition"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_imposition" />

    <!-- ================================================================= -->
    <!-- 23. PDF QUICK TOOL WORKSPACE                                      -->
    <!-- ================================================================= -->
    <ViewStub
        android:id="@+id/stubPdfQuickTool"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout="@layout/layout_pdf_quick_tool" />

    <!-- ================================================================= -->
    <!-- ================================================================= -->
    <!-- 3. FLOATING ACTION DOCK (Tool Mode Only - Pill Dock)             -->
    <!-- ================================================================= -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardCleanerActionDock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/vf_surface"
        app:strokeColor="@color/vf_surface_stroke"
        app:strokeWidth="1dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bottomActionDock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExecute"
                style="@style/Widget.VeilFrame.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="true"
                app:iconGravity="textStart"
                android:text="Execute"
                app:icon="@drawable/ic_action_play"
                app:iconSize="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportResult"
                style="@style/Widget.VeilFrame.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:enabled="false"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="true"
                app:iconGravity="textStart"
                android:text="Save"
                app:icon="@drawable/ic_action_save"
                app:iconTint="@color/vf_primary"
                app:iconSize="18dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareResult"
                style="@style/Widget.VeilFrame.Button.Action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:enabled="false"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="true"
                app:iconGravity="textStart"
                android:text="Share"
                app:icon="@drawable/ic_action_share"
                app:iconTint="@color/vf_primary"
                app:iconSize="18dp"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ================================================================= -->
    <!-- SHELL ADAPTIVE NAVIGATION (Rail for >=600dp, Bar for <600dp)      -->
    <!-- ================================================================= -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/navigationRail"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:visibility="gone"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:visibility="visible"
        app:elevation="8dp"
        app:menu="@menu/bottom_nav_menu" />

    <!-- 8. SETTINGS SLIDE-OVER OVERLAY                                    -->
    <!-- ================================================================= -->
    <View
        android:id="@+id/scrimSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/vf_scrim"
        android:visibility="gone"
        android:elevation="20dp" />

    <FrameLayout
        android:id="@+id/containerSettings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="21dp">

        <include
            android:id="@+id/layoutSettingsPanel"
            layout="@layout/layout_settings_panel" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
