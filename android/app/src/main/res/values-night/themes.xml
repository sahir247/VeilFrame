        <item name="colorPrimaryContainer">#4A3010</item>
        <item name="colorSecondary">#D4B570</item>
        <item name="colorOnSecondary">#291A08</item>
        <item name="colorSecondaryContainer">#4A3010</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Violet" parent="">
