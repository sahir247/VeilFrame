<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode palette overlays for accent palette selections -->

    <!-- Dark Mode Charcoal Overlay (Ensures clean contrast against AMOLED #000000) -->
    <style name="ThemeOverlay.VeilFrame.Dark" parent="">
        <item name="android:windowBackground">@color/vf_bg_dark</item>
        <item name="android:colorBackground">@color/vf_bg_dark</item>
        <item name="colorSurface">@color/vf_surface</item>
        <item name="colorSurfaceVariant">@color/vf_surface_variant</item>
        <item name="colorSurfaceContainer">#1C1C20</item>
        <item name="colorSurfaceContainerLow">#16161A</item>
        <item name="colorSurfaceContainerLowest">#0E0E10</item>
        <item name="colorSurfaceContainerHigh">#242428</item>
        <item name="colorSurfaceContainerHighest">#2C2C32</item>
        <item name="colorOnSurface">@color/vf_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/vf_text_secondary</item>
        <item name="android:statusBarColor">@color/vf_bg_dark</item>
        <item name="android:navigationBarColor">@color/vf_bg_dark</item>
    </style>

    <!-- AMOLED True Black Overlay -->
    <style name="ThemeOverlay.VeilFrame.Amoled" parent="">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#0A0A0C</item>
        <item name="colorSurfaceContainer">#000000</item>
        <item name="colorSurfaceContainerLow">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerHigh">#0B0B0E</item>
        <item name="colorSurfaceContainerHighest">#121216</item>
        <item name="colorOnSurface">@color/vf_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/vf_text_secondary</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Palette Overlays (Night / Dark variants) -->
    <style name="ThemeOverlay.VeilFrame.Palette.Monochrome" parent="">
        <item name="colorPrimary">@color/vf_primary</item>
        <item name="colorOnPrimary">@color/vf_on_primary</item>
        <item name="colorPrimaryContainer">@color/vf_primary_container</item>
        <item name="colorSecondary">@color/vf_secondary</item>
        <item name="colorOnSecondary">@color/vf_on_secondary</item>
        <item name="colorSecondaryContainer">@color/vf_secondary_container</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Sage" parent="">
        <item name="colorPrimary">#6AA878</item>
        <item name="colorOnPrimary">#0D2814</item>
        <item name="colorPrimaryContainer">#1E3826</item>
        <item name="colorSecondary">#8EB99A</item>
        <item name="colorOnSecondary">#0D2814</item>
        <item name="colorSecondaryContainer">#1E3826</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Ocean" parent="">
        <item name="colorPrimary">#7EA8D4</item>
        <item name="colorOnPrimary">#0A1929</item>
        <item name="colorPrimaryContainer">#163050</item>
        <item name="colorSecondary">#93B8DC</item>
        <item name="colorOnSecondary">#0A1929</item>
        <item name="colorSecondaryContainer">#163050</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Amber" parent="">
