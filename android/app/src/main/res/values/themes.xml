<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VeilFrame" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/vf_primary</item>
        <item name="colorOnPrimary">@color/vf_on_primary</item>
        <item name="colorPrimaryContainer">@color/vf_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/vf_text_primary</item>

        <!-- Secondary Accents -->
        <item name="colorSecondary">@color/vf_secondary</item>
        <item name="colorOnSecondary">@color/vf_on_secondary</item>
        <item name="colorSecondaryContainer">@color/vf_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/vf_text_primary</item>

        <!-- Surfaces & Backgrounds -->
        <item name="android:windowBackground">@color/vf_bg_dark</item>
        <item name="colorSurface">@color/vf_surface</item>
        <item name="colorSurfaceVariant">@color/vf_surface_variant</item>
        <item name="colorOnSurface">@color/vf_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/vf_text_secondary</item>

        <!-- Status & Navigation Bars -->
        <item name="android:statusBarColor">@color/vf_bg_dark</item>
        <item name="android:navigationBarColor">@color/vf_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Material 3 Expressive Dialog & Components Styling -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.VeilFrame.MaterialAlertDialog</item>
    </style>

    <!-- Material 3 Expressive Dialog Overlay (28dp extra large shape, surface container) -->
    <style name="ThemeOverlay.VeilFrame.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.VeilFrame.Dialog</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.VeilFrame.Dialog</item>
        <item name="colorSurface">@color/vf_surface</item>
        <item name="colorOnSurface">@color/vf_text_primary</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.VeilFrame.Button.Pill</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.VeilFrame.Button.Text</item>
    </style>

    <style name="ShapeAppearance.VeilFrame.Dialog" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">28dp</item>
    </style>

    <style name="Widget.VeilFrame.Button.Pill" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.VeilFrame.Pill</item>
    </style>

    <style name="Widget.VeilFrame.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearance.VeilFrame.Pill</item>
    </style>

    <style name="ShapeAppearance.VeilFrame.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

    <!-- AMOLED True Black Overlay (meaningful only in night mode, but defined for consistency) -->
    <style name="ThemeOverlay.VeilFrame.Amoled" parent="">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceVariant">#0A0A0C</item>
        <item name="colorOnSurface">@color/vf_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/vf_text_secondary</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Palette Overlays (Light variants) -->
    <style name="ThemeOverlay.VeilFrame.Palette.Monochrome" parent="">
        <item name="colorPrimary">@color/vf_primary</item>
        <item name="colorOnPrimary">@color/vf_on_primary</item>
        <item name="colorPrimaryContainer">@color/vf_primary_container</item>
        <item name="colorSecondary">@color/vf_secondary</item>
        <item name="colorOnSecondary">@color/vf_on_secondary</item>
        <item name="colorSecondaryContainer">@color/vf_secondary_container</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Sage" parent="">
        <item name="colorPrimary">#2E7D32</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#C8E6C9</item>
        <item name="colorSecondary">#388E3C</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#C8E6C9</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Ocean" parent="">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#BBDEFB</item>
        <item name="colorSecondary">#1E88E5</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#BBDEFB</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Amber" parent="">
        <item name="colorPrimary">#D97706</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FDE68A</item>
        <item name="colorSecondary">#F59E0B</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FDE68A</item>
    </style>

    <style name="ThemeOverlay.VeilFrame.Palette.Violet" parent="">
        <item name="colorPrimary">#7C3AED</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#DDD6FE</item>
        <item name="colorSecondary">#8B5CF6</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#DDD6FE</item>
    </style>

    <style name="Widget.VeilFrame.LinearProgressIndicator" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackCornerRadius">8dp</item>
    </style>
</resources>

